{
  "info": {
    "_postman_id": "6bba11e4-7e1d-4a15-93d2-7b4240dcf5a1",
    "name": "Time Manager API - Lab 1",
    "description": "Коллекция проверяет основные сценарии лабораторной работы: регистрацию, JWT-авторизацию, защищенные методы, CRUD задач, теги, учет времени, расписание, уведомления и аналитику.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', `student_${Date.now()}@example.com`);",
          "}",
          "if (!pm.collectionVariables.get('password')) {",
          "  pm.collectionVariables.set('password', 'secret123');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "timeEntryId",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 System - Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is alive', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"full_name\": \"Borodni M. A.\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User registered', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Auth - Login and Save Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token received', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.access_token).to.be.a('string');",
              "  pm.collectionVariables.set('token', json.access_token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Auth - Protected Route Without Token Returns 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request is blocked without token', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Users - Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Current user returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email'));",
