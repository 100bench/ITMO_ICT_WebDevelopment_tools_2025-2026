    {
      "name": "12 Tasks - Detail With Nested Data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task detail contains nested data', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.project.id).to.eql(Number(pm.collectionVariables.get('projectId')));",
              "  pm.expect(json.tag_links).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json.time_entries).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json.total_minutes).to.eql(90);",
              "});"
            ]
          }
        }
      ]
